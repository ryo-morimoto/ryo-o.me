{
  "name": "oshian-blog",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:background": "node ./scripts/dev-background.mjs",
    "dev:stop": "astro dev stop",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs --follow",
    "ensure-dev": "node ./scripts/ensure-dev.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix --deny-warnings",
    "typecheck": "astro sync && tsc --noEmit --checkers 4",
    "typecheck:tsc6": "astro sync && tsc6 --noEmit",
    "check:astro": "astro check --noSync",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "verify": "pnpm test && pnpm typecheck && pnpm check:astro && pnpm lint && pnpm fmt:check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.1",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "astro": "^7.2.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "^7.10.4",
    "wrangler": "^4.123.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.21.0"
}
