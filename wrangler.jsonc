{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "name": "oshian-blog",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Placeholder resource IDs. Local `astro dev` does not need real D1/KV;
  // Quiet Letter falls back to in-memory storage when bindings are empty.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oshian-blog",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "preview_database_id": "local-oshian-blog",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "00000000-0000-0000-0000-000000000002",
      "preview_id": "local-oshian-kv"
    },
    {
      "binding": "SESSION",
      "id": "00000000-0000-0000-0000-000000000003",
      "preview_id": "local-oshian-session"
    }
  ]
}
