---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChangelogList from '../components/ChangelogList.astro';
import { getChangelog } from '../lib/content';
import { site } from '../lib/site';

export const prerender = true;

const entries = await getChangelog();
---

<BaseLayout title={site.title} description={site.description}>
  <section class="hero site-shell">
    <h1 class="brand-hero">{site.name}</h1>
    <p class="tagline">{site.tagline}</p>
  </section>

  <section class="site-shell timeline-section">
    <div class="section-head">
      <h2>Changelog</h2>
      <p>Twitter より静かで、ポートフォリオより人間味のある活動の時間軸。</p>
    </div>
    <ChangelogList entries={entries} />
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-8) 0 var(--space-5);
    min-height: min(58vh, 28rem);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-4);
  }

  .brand-hero {
    margin: 0;
    font-size: var(--text-hero);
    letter-spacing: -0.03em;
    max-width: 8ch;
    animation: press calc(var(--duration) + 80ms) var(--ease-out) both;
  }

  .tagline {
    margin: 0;
    max-width: 28ch;
    font-size: var(--text-lg);
    color: var(--color-ink-soft);
  }

  .timeline-section {
    padding-bottom: var(--space-8);
  }

  .section-head {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .section-head h2 {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: 700;
  }

  .section-head p {
    margin: 0;
    max-width: 36ch;
    color: var(--color-ink-soft);
  }

  @keyframes press {
    from {
      letter-spacing: 0.12em;
      opacity: 0.55;
    }
    to {
      letter-spacing: -0.03em;
      opacity: 1;
    }
  }
</style>
