---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChangelogList from '../components/ChangelogList.astro';
import { getChangelog } from '../lib/content';
import { site } from '../lib/site';

export const prerender = true;

const entries = await getChangelog();
---

<BaseLayout title={site.title} description={site.description}>
  <section class="hero site-shell">
    <p class="eyebrow rise-in">Personal room</p>
    <h1 class="brand-hero rise-in">{site.name}</h1>
    <p class="tagline rise-in">{site.tagline}</p>
  </section>

  <section class="site-shell timeline-section">
    <div class="section-head">
      <h2>Changelog</h2>
      <p>Twitter より静かで、ポートフォリオより人間味のある活動の時間軸。</p>
    </div>
    <ChangelogList entries={entries} />
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-8) 0 var(--space-6);
    min-height: min(72vh, 40rem);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-4);
  }

  .eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-deep);
  }

  .brand-hero {
    margin: 0;
    font-size: var(--text-hero);
    letter-spacing: -0.04em;
    max-width: 10ch;
  }

  .tagline {
    margin: 0;
    max-width: 28ch;
    font-size: var(--text-lg);
    color: var(--color-ink-soft);
  }

  .timeline-section {
    padding-bottom: var(--space-8);
  }

  .section-head {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .section-head h2 {
    margin: 0;
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    font-weight: 500;
  }

  .section-head p {
    margin: 0;
    max-width: 36ch;
    color: var(--color-ink-soft);
  }
</style>
