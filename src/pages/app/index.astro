---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AppLab } from '../../app/AppLab';

export const prerender = false;
---

<BaseLayout title="Lab" description="TanStack の実験場">
  <section class="site-shell lab-page">
    <AppLab client:only="react" />
  </section>
</BaseLayout>

<style>
  .lab-page {
    padding: var(--space-8) 0;
    min-height: 60vh;
  }
</style>
