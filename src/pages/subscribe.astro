---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/site';

export const prerender = true;
---

<BaseLayout title="Subscribe" description="ひかえめな購読。通知スパムはありません。">
  <section class="site-shell sub">
    <h1>Modest Subscribe</h1>
    <p class="lead">
      更新は急かしません。RSS で好きなときに読んでください。メールの週次ダイジェストは、まだ用意していません（週に一度だけ、更新があるときだけ——を想定）。
    </p>
    <a class="rss" href="/rss.xml">RSS フィードを開く</a>
    <p class="note">{site.name} · 広場ではなく部屋</p>
  </section>
</BaseLayout>

<style>
  .sub {
    padding: var(--space-8) 0;
    max-width: 36rem;
  }
  h1 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-2xl);
  }
  .lead {
    color: var(--color-ink-soft);
    font-size: var(--text-lg);
  }
  .rss {
    display: inline-flex;
    margin-top: var(--space-5);
    padding: 0.65rem 1.1rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--color-accent) 35%, transparent);
    background: var(--color-accent-soft);
    color: var(--color-accent-deep);
    text-decoration: none;
  }
  .note {
    margin-top: var(--space-6);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
</style>
