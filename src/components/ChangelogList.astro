---
import { formatDate, kindLabel, type ChangelogEntry } from '../lib/content';

interface Props {
  entries: ChangelogEntry[];
}

const { entries } = Astro.props;

const cuts = ['2.4rem', '1.85rem', '1.45rem', '1.2rem', '1.05rem', '0.95rem'];
---

<ol class="changelog" aria-label="Changelog">
  {
    entries.map((entry, i) => (
      <li class="changelog-item" style={`--cut: ${cuts[Math.min(i, cuts.length - 1)]}`}>
        <div class="meta">
          <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
          <span class="kind">{kindLabel[entry.data.kind] ?? entry.data.kind}</span>
        </div>
        {entry.data.href ? (
          <a class="title" href={entry.data.href}>
            {entry.data.title}
          </a>
        ) : (
          <p class="title plain">{entry.data.title}</p>
        )}
        {entry.data.summary && <p class="summary">{entry.data.summary}</p>}
      </li>
    ))
  }
</ol>

<style>
  .changelog {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .changelog-item {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-6) 0 var(--space-4);
    border-bottom: 1px solid var(--color-line);
  }

  .changelog-item:first-child .title {
    color: var(--color-ink);
  }

  .changelog-item:not(:first-child) .title {
    color: color-mix(in oklab, var(--color-ink) 72%, var(--color-bg));
  }

  .meta {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-family: var(--font-mono);
  }

  .kind {
    color: var(--color-accent);
    font-size: var(--text-sm);
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--cut, var(--text-xl));
    color: var(--color-ink);
    text-decoration: none;
    letter-spacing: -0.02em;
    margin: 0;
    line-height: 1.25;
  }

  a.title:hover {
    color: var(--color-accent);
  }

  .summary {
    margin: 0;
    color: var(--color-ink-soft);
    max-width: 52ch;
  }
</style>
