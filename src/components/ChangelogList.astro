---
import { formatDate, kindLabel, type ChangelogEntry } from '../lib/content';

interface Props {
  entries: ChangelogEntry[];
}

const { entries } = Astro.props;
---

ol class="changelog" aria-label="Changelog">
  {
    entries.map((entry, i) => (
      <li class="changelog-item rise-in" style={`--delay: ${Math.min(i, 8) * 40}ms`}>
        <div class="meta">
          <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
          <span class="kind">{kindLabel[entry.data.kind] ?? entry.data.kind}</span>
        </div>
        {entry.data.href ? (
          <a class="title" href={entry.data.href}>
            {entry.data.title}
          </a>
        ) : (
          <p class="title plain">{entry.data.title}</p>
        )}
        {entry.data.summary && <p class="summary">{entry.data.summary}</p>}
      </li>
    ))
  }
</ol>

<style>
  .changelog {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-line);
  }

  .changelog-item {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--color-line);
    animation-delay: var(--delay);
  }

  .meta {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-family: var(--font-mono);
  }

  .kind {
    color: var(--color-accent-deep);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.72rem;
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-ink);
    text-decoration: none;
    letter-spacing: -0.02em;
    margin: 0;
    line-height: 1.3;
  }

  a.title:hover {
    color: var(--color-accent);
  }

  .summary {
    margin: 0;
    color: var(--color-ink-soft);
    max-width: 52ch;
  }
</style>
