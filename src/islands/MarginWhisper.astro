---
interface Props {
  postId: string;
}

const { postId } = Astro.props;
---

<margin-whisper data-post-id={postId}>
  <div class="whisper-panel" role="dialog" aria-label="なぜ？メモ" hidden>
    <p class="label">なぜ、これは真か？ / 自分ならどう接続するか</p>
    <textarea rows="4"></textarea>
    <div class="actions">
      <button type="button" data-action="save">残す</button>
      <button type="button" class="ghost" data-action="close">閉じる</button>
    </div>
  </div>
</margin-whisper>

<script>
  class MarginWhisperEl extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) {return;}
      this.dataset.ready = '1';
      const start = () => this.#bind();
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start, { once: true });
      } else {
        start();
      }
    }

    #bind() {
      const {postId} = this.dataset;
      const panel = this.querySelector('.whisper-panel');
      const textarea = this.querySelector('textarea');
      const save = this.querySelector('[data-action="save"]');
      const close = this.querySelector('[data-action="close"]');
      const root = document.querySelector('#article-body');
      if (
        !postId ||
        !(panel instanceof HTMLElement) ||
        !(textarea instanceof HTMLTextAreaElement) ||
        !(save instanceof HTMLButtonElement) ||
        !(close instanceof HTMLButtonElement) ||
        !(root instanceof HTMLElement)
      ) {
        return;
      }

      let openId: string | null = null;
      const keyFor = (blockId: string) => `oshian:whisper:${postId}:${blockId}`;

      const closePanel = () => {
        openId = null;
        panel.hidden = true;
      };

      const openPanel = (blockId: string) => {
        openId = blockId;
        textarea.value = localStorage.getItem(keyFor(blockId)) ?? "";
        panel.hidden = false;
        textarea.focus();
      };

      save.addEventListener('click', () => {
        if (openId) {localStorage.setItem(keyFor(openId), textarea.value);}
        closePanel();
      });
      close.addEventListener('click', closePanel);

      const paras = [...root.querySelectorAll('p')].slice(0, 12);
      for (const [i, p] of paras.entries()) {
        if (p.dataset.whisperReady) {
          continue;
        }
        p.dataset.whisperReady = '1';
        p.classList.add('whisper-host');
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'whisper-trigger';
        btn.textContent = '?';
        btn.setAttribute('aria-label', 'なぜ？メモを開く');
        const id = `p-${i}`;
        btn.addEventListener("click", () => openPanel(id));
        p.append(btn);
      }
    }
  }

  if (!customElements.get('margin-whisper')) {
    customElements.define('margin-whisper', MarginWhisperEl);
  }
</script>

<style>
  margin-whisper {
    display: contents;
  }

  .whisper-panel {
    position: fixed;
    right: 1rem;
    bottom: 4.5rem;
    width: min(22rem, calc(100vw - 2rem));
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    padding: 1rem;
    z-index: 60;
    box-shadow: 0 12px 40px color-mix(in oklab, var(--color-ink) 8%, transparent);
  }

  .label {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }

  textarea {
    width: 100%;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    padding: 0.65rem;
    font: inherit;
    background: white;
    color: inherit;
  }

  .actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }

  .actions button {
    border: 1px solid var(--color-line);
    background: var(--color-accent-soft);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    font: inherit;
    cursor: pointer;
  }

  .actions .ghost {
    background: transparent;
  }
</style>
