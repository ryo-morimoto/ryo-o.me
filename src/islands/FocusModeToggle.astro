---
const KEY = 'oshian:focus-mode';
---

<focus-mode-toggle data-storage-key={KEY}>
  <button type="button" class="focus-btn site-chrome" aria-pressed="false" title="Focus mode (R)">
    <span class="label">Focus</span>
    <kbd>R</kbd>
  </button>
</focus-mode-toggle>

<script>
  class FocusModeToggleEl extends HTMLElement {
    #button: HTMLButtonElement | null = null;
    #onKey: ((e: KeyboardEvent) => void) | null = null;

    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = '1';
      this.#button = this.querySelector('button');
      const label = this.querySelector('.label');
      const key = this.dataset.storageKey ?? 'oshian:focus-mode';
      if (!this.#button || !(label instanceof HTMLElement)) return;

      const apply = (on: boolean) => {
        document.body.classList.toggle('is-focus-mode', on);
        sessionStorage.setItem(key, on ? '1' : '0');
        this.#button?.setAttribute('aria-pressed', on ? 'true' : 'false');
        label.textContent = on ? 'Exit focus' : 'Focus';
      };

      const toggle = () => {
        apply(sessionStorage.getItem(key) !== '1');
      };

      apply(sessionStorage.getItem(key) === '1');

      this.#button.addEventListener('click', toggle);
      this.#onKey = (e: KeyboardEvent) => {
        const t = e.target as HTMLElement | null;
        if (!t) return;
        if (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable) return;
        if (e.key === 'r' || e.key === 'R') {
          e.preventDefault();
          toggle();
        }
      };
      window.addEventListener('keydown', this.#onKey);
    }

    disconnectedCallback() {
      if (this.#onKey) window.removeEventListener('keydown', this.#onKey);
    }
  }

  if (!customElements.get('focus-mode-toggle')) {
    customElements.define('focus-mode-toggle', FocusModeToggleEl);
  }
</script>

<style>
  focus-mode-toggle {
    display: contents;
  }

  .focus-btn {
    position: fixed;
    left: calc(var(--rail-w) + 1rem);
    bottom: 1rem;
    z-index: 45;
    border: 1px solid var(--color-ink);
    background: var(--color-proof);
    padding: 0.5rem 0.75rem;
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    font-size: 0.8rem;
    color: var(--color-ink);
    cursor: pointer;
    font-family: var(--font-mono);
  }

  .focus-btn kbd {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    border: 1px solid var(--color-line);
    padding: 0.05rem 0.3rem;
  }

  .focus-btn[aria-pressed='true'] {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
