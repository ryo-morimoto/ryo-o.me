---
interface Props {
  contentSelector?: string;
}

const { contentSelector = '#article-body' } = Astro.props;
---

<reading-rail data-content-selector={contentSelector} style="--p: 0">
  <div class="rail progress-only" aria-hidden="true" hidden>
    <div class="bar"></div>
  </div>

  <nav class="rail desktop" aria-label="目次" hidden>
    <p class="rail-title">On this page</p>
    <div class="track" aria-hidden="true">
      <div class="bar"></div>
    </div>
    <ol></ol>
  </nav>

  <div class="mobile-bar site-chrome" hidden>
    <button type="button" class="mobile-toggle" aria-expanded="false">
      <span class="mobile-progress"></span>
      <span class="mobile-label">この記事</span>
    </button>
    <ol class="mobile-list" hidden></ol>
  </div>
</reading-rail>

<script>
  type Heading = { id: string; text: string; level: number };

  class ReadingRailEl extends HTMLElement {
    #observer: IntersectionObserver | null = null;
    #onScroll: (() => void) | null = null;

    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = '1';
      const selector = this.dataset.contentSelector ?? '#article-body';
      const root = document.querySelector(selector);
      const progressOnly = this.querySelector('.progress-only');
      const desktop = this.querySelector('nav.desktop');
      const desktopList = this.querySelector('nav.desktop ol');
      const mobileBar = this.querySelector('.mobile-bar');
      const mobileToggle = this.querySelector('.mobile-toggle');
      const mobileList = this.querySelector('.mobile-list');
      const mobileLabel = this.querySelector('.mobile-label');
      const mobileProgress = this.querySelector('.mobile-progress');

      if (
        !(root instanceof HTMLElement) ||
        !(progressOnly instanceof HTMLElement) ||
        !(desktop instanceof HTMLElement) ||
        !(desktopList instanceof HTMLOListElement) ||
        !(mobileBar instanceof HTMLElement) ||
        !(mobileToggle instanceof HTMLButtonElement) ||
        !(mobileList instanceof HTMLOListElement) ||
        !(mobileLabel instanceof HTMLElement) ||
        !(mobileProgress instanceof HTMLElement)
      ) {
        return;
      }

      const headings: Heading[] = [...root.querySelectorAll('h2[id], h3[id]')].map((el) => ({
        id: el.id,
        text: el.textContent?.trim() ?? '',
        level: el.tagName === 'H3' ? 3 : 2,
      }));

      const setProgress = (value: number) => {
        this.style.setProperty('--p', String(value));
        mobileProgress.style.transform = `scaleX(${value})`;
      };

      const onScroll = () => {
        const rect = root.getBoundingClientRect();
        const total = root.scrollHeight - window.innerHeight;
        const traveled = Math.min(Math.max(-rect.top, 0), Math.max(total, 1));
        setProgress(total <= 0 ? 1 : traveled / total);
      };

      this.#onScroll = onScroll;
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      if (headings.length === 0) {
        progressOnly.hidden = false;
        return;
      }

      desktop.hidden = false;
      mobileBar.hidden = false;

      const renderList = (list: HTMLOListElement, withLevel: boolean) => {
        list.replaceChildren(
          ...headings.map((h) => {
            const li = document.createElement('li');
            if (withLevel) li.dataset.level = String(h.level);
            const a = document.createElement('a');
            a.href = `#${h.id}`;
            a.textContent = h.text;
            li.append(a);
            return li;
          }),
        );
      };

      renderList(desktopList, true);
      renderList(mobileList, false);

      const setActive = (id: string) => {
        const label = headings.find((h) => h.id === id)?.text ?? 'この記事';
        mobileLabel.textContent = label;
        this.querySelectorAll('nav.desktop li, .mobile-list a').forEach((el) => {
          if (el instanceof HTMLElement) delete el.dataset.active;
        });
        desktopList.querySelectorAll('li').forEach((li) => {
          const href = li.querySelector('a')?.getAttribute('href');
          if (href === `#${id}`) li.dataset.active = 'true';
        });
        mobileList.querySelectorAll('a').forEach((a) => {
          if (a.getAttribute('href') === `#${id}`) a.dataset.active = 'true';
        });
      };

      this.#observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible[0]?.target.id) setActive(visible[0].target.id);
        },
        { rootMargin: '-20% 0px -65% 0px', threshold: [0, 1] },
      );
      root.querySelectorAll('h2[id], h3[id]').forEach((t) => this.#observer?.observe(t));

      mobileToggle.addEventListener('click', () => {
        const open = mobileList.hidden;
        mobileList.hidden = !open;
        mobileToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });

      mobileList.addEventListener('click', (e) => {
        if (!(e.target instanceof HTMLAnchorElement)) return;
        mobileList.hidden = true;
        mobileToggle.setAttribute('aria-expanded', 'false');
      });
    }

    disconnectedCallback() {
      this.#observer?.disconnect();
      if (this.#onScroll) window.removeEventListener('scroll', this.#onScroll);
    }
  }

  if (!customElements.get('reading-rail')) {
    customElements.define('reading-rail', ReadingRailEl);
  }
</script>

<style>
  reading-rail {
    display: contents;
  }

  .rail.desktop {
    display: none;
  }

  @media (min-width: 1100px) {
    .rail.desktop {
      display: block;
      position: fixed;
      top: calc(var(--header-h) + 2rem);
      right: max(1.25rem, calc((100vw - 1120px) / 2 - var(--rail-w) - 1rem));
      width: var(--rail-w);
      font-size: 0.82rem;
    }
  }

  .rail-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .track {
    height: 2px;
    background: var(--color-line);
    margin-bottom: 1rem;
    border-radius: 999px;
    overflow: hidden;
  }

  .bar {
    height: 100%;
    width: 100%;
    transform-origin: left center;
    transform: scaleX(var(--p, 0));
    background: var(--color-accent);
    transition: transform 120ms linear;
  }

  .rail ol,
  .mobile-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .rail a,
  .mobile-list a {
    color: var(--color-muted);
    text-decoration: none;
    display: inline-block;
    transition:
      color var(--duration) var(--ease-out),
      transform var(--duration) var(--ease-out);
  }

  .rail li[data-level='3'] a {
    padding-left: 0.75rem;
  }

  .rail li[data-active='true'] a,
  .mobile-list a[data-active='true'] {
    color: var(--color-accent-deep);
    transform: translateX(2px);
  }

  .progress-only {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 50;
    background: transparent;
  }

  .progress-only .bar {
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(var(--p, 0));
    transform-origin: left center;
  }

  .mobile-bar {
    position: sticky;
    top: var(--header-h);
    z-index: 30;
    margin: 0 0 1.5rem;
  }

  @media (min-width: 1100px) {
    .mobile-bar {
      display: none;
    }
  }

  .mobile-toggle {
    width: 100%;
    border: 1px solid var(--color-line);
    background: color-mix(in oklab, var(--color-bg-elevated) 90%, transparent);
    backdrop-filter: blur(8px);
    border-radius: 0.5rem;
    padding: 0.7rem 0.9rem;
    text-align: left;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    font: inherit;
    color: inherit;
  }

  .mobile-progress {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 100%;
    background: var(--color-accent);
    transform-origin: left center;
    transform: scaleX(var(--p, 0));
  }

  .mobile-label {
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }

  .mobile-list {
    margin-top: 0.4rem;
    padding: 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    background: var(--color-bg-elevated);
  }
</style>
